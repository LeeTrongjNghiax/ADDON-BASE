{
  "format_version": "1.13.0",
  "minecraft:tree_feature": {
    "description": { "identifier": "your_namespace:custom_tree_feature" },
    "cherry_trunk": {
      "trunk_block": "minecraft:dark_oak_log",
      "trunk_height": { "base": 64, "intervals": [1] },
      "branches": {
        "tree_type_weights": { "one_branch": 10, "two_branches": 30, "two_branches_and_trunk": 50 },
        "branch_horizontal_length": { "range_min": 2, "range_max": 8 },
        "branch_start_offset_from_top": { "range_min": -5, "range_max": -6 },
        "branch_end_offset_from_top": { "range_min": -1, "range_max": 0 },
        "branch_canopy": {
          "cherry_canopy": {
            "leaf_block": "minecraft:leaves2",
            "height": 5,
            "radius": 3,
            "wide_bottom_layer_hole_chance": 25,
            "corner_hole_chance": 50,
            "hanging_leaves_chance": 16.6666,
            "hanging_leaves_extension_chance": 33.3333
          }
        }
      }
    },
    "cherry_canopy": {
      "leaf_block": "minecraft:leaves",
      "height": 5,
      "radius": 4,
      "wide_bottom_layer_hole_chance": 99,
      "corner_hole_chance": 80,
      "hanging_leaves_chance": 40,
      "hanging_leaves_extension_chance": 33.3333
    },
    "may_grow_on": [{ "tags": "query.any_tag('dirt')" }],
    "base_block": ["minecraft:dirt", "minecraft:coarse_dirt"],
    "may_grow_through": [{ "tags": "query.any_tag('dirt')" }],
    "may_replace": [
      "minecraft:air",
      "minecraft:leaves",
      "minecraft:leaves2",
      "minecraft:azalea_leaves",
      "minecraft:azalea_leaves_flowered",
      "minecraft:mangrove_leaves",
      "minecraft:snow_layer"
    ]
  }
}
