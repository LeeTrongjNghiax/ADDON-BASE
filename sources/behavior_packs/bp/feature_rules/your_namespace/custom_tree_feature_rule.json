{
  "format_version": "1.16.0",
  "minecraft:feature_rules": {
    "description": {
      "identifier": "your_namespace:custom_tree_feature_rule",
      "places_feature": "your_namespace:custom_tree_feature"
    },
    "conditions": {
      "placement_pass": "after_surface_pass",
      "minecraft:biome_filter": [{ "test": "has_biome_tag", "value": "overworld" }]
    },
    "distribution": {
      "iterations": "Math.Random(0, 10)",
      "x": { "distribution": "uniform", "extent": [0, 16] },
      "y": { "distribution": "uniform", "extent": [-64, 256] },
      "z": { "distribution": "uniform", "extent": [0, 16] }
    }
  }
}
