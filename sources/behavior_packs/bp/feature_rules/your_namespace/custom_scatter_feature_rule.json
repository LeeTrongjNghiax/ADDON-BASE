{
  "format_version": "1.26.0",
  "minecraft:feature_rules": {
    "description": {
      "identifier": "your_namespace:custom_scatter_feature_rule",
      "places_feature": "your_namespace:custom_scatter_feature"
    },
    "conditions": {
      "placement_pass": "after_surface_pass",
      "minecraft:biome_filter": [{ "test": "has_biome_tag", "value": "forest" }]
    },
    "distribution": {
      "iterations": "Math.Random(0, 10)",
      "x": { "distribution": "jittered_grid", "extent": [0, 15], "step_size": 10, "grid_offset": 4 },
      "z": { "distribution": "jittered_grid", "extent": [0, 15], "step_size": 10, "grid_offset": 4 },
      "y": { "distribution": "uniform", "extent": [-64, 256] }
    }
  }
}
