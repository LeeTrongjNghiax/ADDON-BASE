{
  "format_version": "1.26.0",
  "minecraft:entity": {
    "description": {
      "identifier": "your_namespace:custom_entity",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false,
      "properties": { "tb:custom_boolean_property": { "type": "bool", "default": false, "client_sync": true } },
      "animations": { "custom_animation": "animation.custom_entity.custom_animation" },
      "scripts": { "animate": [{ "custom_animation": "q.property('tb:custom_boolean_property') == false" }] }
    },

    "components": {
      "minecraft:annotation.break_door": {},
      "minecraft:behavior.break_door": {},
      "minecraft:behavior.float": { "priority": 0 },
      "minecraft:behavior.hurt_by_target": { "priority": 1 },
      "minecraft:behavior.look_at_player": { "priority": 7, "look_distance": 6, "probability": 0.02 },
      "minecraft:behavior.ranged_attack": { "attack_interval_min": 1, "attack_interval_max": 3, "attack_radius": 15 },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 2,
        "within_radius": 32,
        "reselect_targets": true,
        "entity_types": [
          {
            "filters": {
              "any_of": [
                { "test": "is_family", "subject": "other", "value": "player" },
                { "test": "is_family", "subject": "other", "value": "zombie" },
                { "test": "is_family", "subject": "other", "value": "pirate_ship" }
              ]
            },
            "must_see": false,
            "max_dist": 32
          }
        ],
        "must_see": true,
        "must_see_forget_duration": 17.0
      },
      "minecraft:behavior.player_ride_tamed": {},
      "minecraft:behavior.random_stroll": { "interval": 2, "priority": 6, "speed_multiplier": 1 },
      "minecraft:behavior.rise_to_liquid_level": {
        "priority": 0,
        "liquid_y_offset": -10,
        "rise_delta": 0.01,
        "sink_delta": 0.01
      },
      "minecraft:health": { "value": 15, "max": 15 },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": { "test": "in_lava", "subject": "self", "operator": "==", "value": true },
            "cause": "lava",
            "damage_per_tick": 4
          }
        ]
      },
      "minecraft:input_ground_controlled": {},
      "minecraft:inventory": { "inventory_size": 4, "container_type": "chest" },
      "minecraft:is_collidable": {},
      "minecraft:is_stackable": {},
      "minecraft:is_tamed": {},
      "minecraft:knockback_resistance": { "value": 100, "max": 100 },
      "minecraft:movement.basic": { "max_turn": 1 },
      "minecraft:movement": { "value": 0.1 },
      "minecraft:navigation.walk": { "can_sink": false },
      "minecraft:on_death": { "event": "rl_pa:spawn_portal", "target": "self" },
      "minecraft:physics": {},
      "minecraft:pushable": { "is_pushable": false, "is_pushable_by_piston": false },
      "minecraft:push_through": 1,
      "minecraft:renders_when_invisible": {},
      "minecraft:spell_effects": {
        "add_effects": [{ "visible": false, "effect": "invisibility", "duration": "infinite" }]
      },
      "minecraft:underwater_movement": { "value": 0.3 }
    },
    "events": {
      "rl_pa:spawn_portal": {
        "randomize": [
          { "weight": 90 },
          {
            "weight": 10,
            "queue_command": {
              "command": [
                "structure load rl_pa:royal_gateway_platform ~~~ 0_degrees none false true true",
                "summon rl_pa:royal_gateway ~2 ~1 ~2"
              ]
            }
          }
        ]
      },
      "rl_pa:set_ship_level_0": {
        "set_property": { "rl_pa:ship_level": 0 },
        "add": { "component_groups": ["rl_pa:royal_ship_level_0"] },
        "remove": { "component_groups": ["rl_pa:royal_ship_level_1"] }
      },
      "rl_pa:set_ship_level_1": {
        "set_property": { "rl_pa:ship_level": 1 },
        "add": { "component_groups": ["rl_pa:royal_ship_level_1"] },
        "remove": { "component_groups": ["rl_pa:royal_ship_level_0"] }
      },
      "minecraft:entity_spawned": { "add": { "component_groups": ["rl_pa:royal_ship_level_0"] } }
    },

    "component_groups": {
      "rl_pa:royal_ship_level_0": {
        "minecraft:collision_box": { "width": 2.9, "height": 1.5 },
        "minecraft:loot": { "table": "loot_tables/entities/royal_ship_1.json" }
      },
      "rl_pa:royal_ship_level_1": {
        "minecraft:collision_box": { "width": 1, "height": 1 },
        "minecraft:loot": { "table": "loot_tables/entities/royal_ship_2.json" }
      }
    }
  }
}
